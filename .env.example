# Copy to .env and run `docker compose up`. Every value below is safe to use as
# is: Telegram and Turnstile are disabled, so the fake clients are wired in and
# no real secret is needed to run the project locally.

# --- core ---------------------------------------------------------------------
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost, 127.0.0.1, web
SITE_URL=http://localhost:8000
TIME_ZONE=Europe/Kyiv
USE_TZ=True

# --- db / redis / celery ------------------------------------------------------
# Credentials match the `db` service in compose.yaml.
DATABASE_URL=postgresql://flowers:flowers@db:5432/flowers
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- telegram -----------------------------------------------------------------
# TELEGRAM_ENABLED=False selects the fake client, no network calls are made.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=False

# --- turnstile ----------------------------------------------------------------
# TURNSTILE_ENABLED=False makes the verifier accept every token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=False

# --- antispam -----------------------------------------------------------------
LEAD_RATE_PER_IP_HOUR=5
LEAD_RATE_GLOBAL_DAY=20
REVIEW_RATE_PER_IP_HOUR=2
REVIEW_RATE_GLOBAL_DAY=20
FORM_MIN_FILL_SECONDS=3
# Placeholder. Replace with a unique value before the production launch.
IP_HASH_SALT=dev-insecure-ip-hash-salt-change-me

# --- media --------------------------------------------------------------------
MEDIA_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
