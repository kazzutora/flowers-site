# Copy to .env and fill in. Every key here matches a field in
# config/settings/env.py — that module is the only place these are read
# (tech.md §6.1). Values below are safe, non-secret placeholders; no real
# credential belongs in this file or anywhere in the repo (tech.md §10.7).

# --- Core Django ------------------------------------------------------
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# --- Database (tech.md §2: PostgreSQL 16) ------------------------------
POSTGRES_DB=flowers
POSTGRES_USER=flowers
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis: db0 cache, db1 sessions, db2 celery broker/result (tech.md §7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_SESSIONS_DB=1
REDIS_CELERY_DB=2

# --- Email (mailhog locally; real SMTP in prod) ------------------------
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@flowers.local

# --- External providers, selected by factory (tech.md §9.1) -----------
# "fake" everywhere runs the whole site against fakes with zero real
# secrets. Real providers land stage by stage (payments: stage 6, sms/
# messenger: stage 5, stream: stage 2) and each adds its own key names
# here when that stage freezes them in tech.md.
PAYMENT_PROVIDER=fake
SMS_PROVIDER=fake
MESSENGER_PROVIDER=fake
STREAM_PROVIDER=fake

# --- Observability ------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Object storage, prod only (S3-compatible, tech.md §2) -------------
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
